# 이 파일을 복사해서 ".streamlit/secrets.toml"로 저장하고, 아래 값을 실제 값으로 채워넣으세요.
# secrets.toml은 .gitignore에 등록되어 있어서 깃에는 절대 올라가지 않습니다.
# Streamlit Community Cloud에 배포할 때는 이 내용을 그대로 "Secrets" 설정 화면에 붙여넣으면 됩니다.

# 앱 자체 비밀번호 (폰 브라우저로 들어올 때 입력하는 비밀번호, 원하는 값으로 정하세요)
APP_PASSWORD = "여기에_원하는_비밀번호"

# 한국투자증권 Open API 신청 후 발급받은 값
KIS_APP_KEY = "여기에_App_Key"
KIS_APP_SECRET = "여기에_App_Secret"

# 구글 스프레드시트 ID (스프레드시트 URL에서 /d/ 와 /edit 사이 문자열)
GSHEET_SPREADSHEET_ID = "여기에_스프레드시트_ID"

# 구글 서비스 계정 JSON 키의 내용을 그대로 옮겨 적으세요.
# (구글 클라우드 콘솔에서 서비스 계정 만들고 다운받은 .json 파일을 열어서 복사)
[gcp_service_account]
type = "service_account"
project_id = "여기에_project_id"
private_key_id = "여기에_private_key_id"
private_key = "여기에_private_key (-----BEGIN PRIVATE KEY----- 로 시작하는 긴 문자열)"
client_email = "여기에_client_email"
client_id = "여기에_client_id"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "여기에_client_x509_cert_url"
